PORT=3000
ENV=production

# MongoDB connection string (without the trailing db name — the app appends it)
MONGOURI=
DB_NAME=PrepMateAI

# Long random string used to sign JWTs (generate: python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=

# Redis connection string (logout token blacklist + report cache)
REDIS_URL=

# Groq API key — https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=
# GROQ_MODEL = quality model for the report; GROQ_FAST_MODEL = optional extraction model.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FAST_MODEL=
GROQ_MAX_TOKENS=4096
GROQ_REASONING_EFFORT=low

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
